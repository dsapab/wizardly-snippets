# ============================================================================
#  ~/.zsh/config.zsh — personal prompt settings
# ----------------------------------------------------------------------------
#  Safe to edit. The installer copies this template to ~/.zsh/config.zsh ONLY
#  if that file does not exist yet, so your choices survive updates. The rest
#  of the config (~/.zshrc, ~/.zsh/*.zsh) is overwritten on update; this file
#  is not.
# ============================================================================

# Icon style for the prompt:
#   plain      — symbols found in any preinstalled font (no font to install)
#   emoji      — system emoji (no font to install; colorful, wider)
#   nerd-font  — the bundled JetBrainsMono FA glyphs (installer adds the font)
ZSH_PROMPT_ICONS=nerd-font

# Show the hostname after the username in the prompt (user@host): true | false
ZSH_PROMPT_SHOW_HOST=true
